          onmouseover="this.style.background='var(--terracotta)'" onmouseout="this.style.background='var(--chocolate)'">
          Solicitar Cotización
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </button>
