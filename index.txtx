        <div><label class="c-label">Largo (metros)</label><input id="cl" class="c-input" type="number" min="1" max="10" step="0.5" value="2" oninput="updCalc()" /></div>
      </div>
      <div>
        <label class="c-label">Tipo de Accionamiento</label>
        <div class="toggle-row">
          <button class="tgl-btn on" data-tp="manual"     onclick="setTp('manual')">Manual</button>
          <button class="tgl-btn"    data-tp="motorizado" onclick="setTp('motorizado')">Motorizado</button>
        </div>
      </div>
      <div>
        <label class="c-label">Tipo de Tela</label>
