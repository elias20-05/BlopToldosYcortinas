<!DOCTYPE html>
<html lang="es">
  <head>
      <style>
        body {
          font-family: sans-serif;
        }
      </style>
</head>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BLOP | Toldos y Cortinas</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;900&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,600&display=swap" rel="stylesheet" />
  <style>

    /* ========== VARIABLES ========== */
    :root {
      --terracotta: #c17b5f;
      --chocolate:  #3d3226;
      --cream:      #fdf8f4;
    }
    html { scroll-behavior: smooth; }
    *, *::before, *::after { box-sizing: border-box; }
    body {
      font-family: 'Inter', sans-serif;
      background: var(--cream); color: #1a1a1a;
      margin: 0; padding: 0; overflow-x: hidden;
    }

    /* ========== NAVBAR ========== */
    #navbar {
      position: fixed; top: 0; left: 0; width: 100%;
      z-index: 100; padding: 16px 0; background: transparent;
      transition: background 0.5s, padding 0.5s, box-shadow 0.5s;
    }
    #navbar.scrolled {
      background: rgba(253,248,244,0.96);
      backdrop-filter: blur(12px);
      padding: 8px 0;
      box-shadow: 0 2px 30px rgba(61,50,38,0.08);
    }
    .nav-inner {
      max-width: 1280px; margin: 0 auto; padding: 0 32px;
      display: flex; justify-content: space-between; align-items: center;
    }
    /* Logo container box */
    #logo-box {
      display: flex; flex-direction: column; align-items: center;
      text-decoration: none; user-select: none;
      background: rgba(255,255,255,0.06);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255,255,255,0.14);
      border-radius: 16px; padding: 12px 20px;
      transition: background 0.5s, border-color 0.5s, padding 0.5s, border-radius 0.5s;
    }
    #navbar.scrolled #logo-box {
      background: transparent;
      border-color: transparent;
      padding: 4px 8px;
    }
    #logo-name {
      font-weight: 900; font-size: 22px; letter-spacing: -0.02em;
      line-height: 1; color: white; margin: 0;
      transition: color 0.5s;
    }
    #logo-tagline {
      font-size: 10px; font-weight: 700;
      letter-spacing: 0.26em; text-transform: uppercase;
      margin-top: 2px; color: rgba(255,255,255,0.88);
      transition: color 0.5s;
    }
    #navbar.scrolled #logo-name    { color: var(--chocolate); }
    #navbar.scrolled #logo-tagline { color: rgba(61,50,38,0.78); }

    /* Desktop nav links — always visible on lg */
    #nav-links {
      display: flex; align-items: center; gap: 40px;
    }
    /* Hide on small screens */
    @media (max-width: 1023px) { #nav-links { display: none; } }

    .nav-link {
      font-weight: 900; font-size: 12px;
      letter-spacing: 0.25em; text-transform: uppercase;
      text-decoration: none; color: white;
      position: relative; transition: color 0.3s;
    }
    .nav-link::after {
      content: ''; display: block; position: absolute;
      bottom: -3px; left: 0; width: 0; height: 2px;
      background: var(--terracotta); transition: width 0.3s;
    }
    .nav-link:hover { color: var(--terracotta); }
    .nav-link:hover::after { width: 100%; }
    #navbar.scrolled .nav-link       { color: var(--chocolate); }
    #navbar.scrolled .nav-link:hover { color: var(--terracotta); }

    /* Hamburger — only on mobile */
    #nav-hamburger {
      display: none; /* shown via media query below */
      background: none; border: none; cursor: pointer;
      color: white; padding: 6px; transition: color 0.3s;
    }
    #navbar.scrolled #nav-hamburger { color: var(--chocolate); }
    @media (max-width: 1023px) { #nav-hamburger { display: flex; align-items: center; } }

    /* Mobile overlay */
    #mobile-menu {
      position: fixed; top: 0; left: 0;
      width: 100%; height: 100vh;
      background: white; z-index: 110;
      display: none;
      flex-direction: column; align-items: center; justify-content: center;
      gap: 36px;
    }
    #mobile-menu.open { display: flex; }
    #mobile-close {
      position: absolute; top: 28px; right: 28px;
      background: none; border: none; cursor: pointer; color: var(--chocolate);
    }
    .mobile-link {
      font-family: 'Playfair Display', serif; font-size: 26px; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.1em;
      color: var(--chocolate); text-decoration: none;
      transition: color 0.3s;
    }
    .mobile-link:hover { color: var(--terracotta); }
    .mobile-cta {
      background: var(--terracotta); color: white; text-decoration: none;
      padding: 18px 36px; border-radius: 9999px;
      font-weight: 900; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase;
      box-shadow: 0 10px 30px rgba(193,123,95,0.3);
    }

    /* ========== HERO ========== */
    #hero {
      position: relative; height: 100vh;
      display: flex; align-items: center; overflow: hidden;
    }
    #hero-bg {
      position: absolute; inset: 0;
    }
    #hero-bg img {
      width: 100%; height: 100%; object-fit: cover; transform: scale(1.06);
    }
    .hero-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to right,
        
        transparent 100%);
    }
    .hero-content {
      position: relative; z-index: 10;
      max-width: 1280px; width: 100%; margin: 0 auto; padding: 0 32px;
    }
    .hero-content h1 {
      font-family:  serif ;
      font-size: clamp(39px, 6vw, 59px);
      font-weight: 700; color: rgb(250, 248, 248);
      text-transform: uppercase; letter-spacing: -0.02em;
      line-height: 1.08; margin: 0 0 28px; max-width: 600px;
      animation: fadeUp 0.8s ease both;
    }
    .hero-content h1 em {
      font-style: italic; font-weight: 600; text-transform: lowercase;
      padding-right: 8px;
    }
    .hero-content p {
      font-size: 18px; color: rgba(255,255,255,0.96);
      max-width: 460px; line-height: 1.72; font-weight: 300;
      margin: 0 0 44px;
      animation: fadeUp 0.8s 0.15s ease both;
    }
    .hero-btns {
      display: flex; flex-wrap: wrap; gap: 20px;
      animation: fadeUp 0.8s 0.3s ease both;
    }
    .btn-primary {
      display: inline-flex; align-items: center; justify-content: center;
      padding: 18px 40px; background: var(--terracotta); color: white;
      font-weight: 900; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase;
      text-decoration: none; border-radius: 9999px;
      box-shadow: 0 14px 30px -4px rgba(193,123,95,0.44);
      transition: background 0.3s, transform 0.2s;
    }
    .btn-primary:hover { background: #a8674a; transform: scale(1.04); }
    .btn-glass {
      display: inline-flex; align-items: center; justify-content: center;
      padding: 18px 40px; color: white;
      background: rgba(255,255,255,0.1); backdrop-filter: blur(8px);
      border: 1px solid rgba(255,255,255,0.32);
      font-weight: 900; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase;
      text-decoration: none; border-radius: 9999px;
      transition: background 0.3s, transform 0.2s;
    }
    .btn-glass:hover { background: rgba(255,255,255,0.2); transform: scale(1.04); }
    .scroll-hint {
      position: absolute; bottom: 48px; left: 50%;
      transform: translateX(-50%);
      display: flex; flex-direction: column; align-items: center; gap: 6px;
      opacity: 0.3;
      animation: scrollBounce 2s ease-in-out infinite;
    }

    /* ========== SECTIONS ========== */
    section { scroll-margin-top: 80px; }
    .container { max-width: 1280px; margin: 0 auto; padding: 0 32px; }

    /* Section header */
    .sec-header {
      text-align: center; display: flex; flex-direction: column; align-items: center;
      margin-bottom: 72px;
    }
    .sec-label {
      display: flex; align-items: center; gap: 16px; margin-bottom: 18px;
    }
    .sec-label-line { width: 24px; height: 1px; background: rgba(193,123,95,0.42); }
    .sec-label span {
      font-weight: 900; font-size: 10px; letter-spacing: 0.5em;
      text-transform: uppercase; color: var(--terracotta);
    }
    .sec-title {
      font-family: 'Playfair Display', serif; font-weight: 700;
      font-size: clamp(34px, 4vw, 52px);
      color: var(--chocolate); text-transform: uppercase;
      letter-spacing: -0.02em; line-height: 1.1; margin: 0 0 20px;
    }
    .sec-sub {
      font-size: 14px; color: #64748b; font-weight: 300;
      max-width: 460px; line-height: 1.72; padding: 0 20px;
    }
    .sec-divider {
      display: flex; align-items: center; gap: 12px; margin-top: 36px;
    }
    .sd-line { width: 30px; height: 2px; background: rgba(61,50,38,0.07); border-radius: 9px; }
    .sd-diamond { width: 8px; height: 8px; border: 1px solid rgba(193,123,95,0.38); transform: rotate(45deg); }

    /* ========== SERVICIOS ========== */
    #servicios { padding: 96px 0; background: white; }
    .srv-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px; max-width: 1100px; margin: 0 auto;
    }
    .srv-card {
      background: white; padding: 40px 36px; border-radius: 18px;
      border: 1px solid rgba(61,50,38,0.09);
      box-shadow: 0 6px 28px rgba(61,50,38,0.06);
      transition: transform 0.4s, box-shadow 0.4s;
    }
    .srv-card:hover { transform: translateY(-5px); box-shadow: 0 20px 50px rgba(61,50,38,0.13); }
    .srv-icon {
      width: 64px; height: 64px; background: white; border-radius: 16px;
      display: flex; align-items: center; justify-content: center;
      border: 1px solid rgba(61,50,38,0.06);
      box-shadow: 0 2px 8px rgba(61,50,38,0.06);
      margin-bottom: 24px; transition: transform 0.3s;
    }
    .srv-card:hover .srv-icon { transform: scale(1.1); }
    .srv-card h3 {
      font-family: 'Playfair Display', serif; font-weight: 700; font-size: 22px;
      color: var(--chocolate); margin: 0 0 12px;
    }
    .srv-card p { font-size: 14px; color: #64748b; font-weight: 300; line-height: 1.7; margin: 0; }
    .calc-link {
      display: inline-flex; align-items: center; gap: 8px; margin-top: 24px;
      background: none; border: none; cursor: pointer; padding: 0;
      font-family: 'Inter', sans-serif; font-size: 10px; font-weight: 900;
      text-transform: uppercase; letter-spacing: 0.2em;
      color: var(--terracotta); transition: color 0.3s;
    }
    .calc-link:hover { color: var(--chocolate); }

    /* ========== PRODUCTOS ========== */
    #productos { padding: 96px 0; background: var(--cream); }
    .filter-row {
      display: flex; flex-wrap: wrap; justify-content: center; gap: 12px;
      margin-bottom: 56px;
    }
    .flt-btn {
      padding: 12px 32px; border-radius: 9999px; cursor: pointer;
      font-weight: 900; font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase;
      border: 1px solid rgba(61,50,38,0.09); background: white;
      color: rgba(61,50,38,0.36); transition: all 0.32s;
    }
    .flt-btn.active { background: var(--chocolate); color: white; border-color: var(--chocolate); box-shadow: 0 6px 20px rgba(61,50,38,0.14); }
    #products-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 28px;
    }
    .prod-card {
      position: relative; aspect-ratio: 4/5; overflow: hidden;
      border-radius: 40px; cursor: pointer;
      background: var(--chocolate);
      border: 1px solid rgba(61,50,38,0.06);
      box-shadow: 0 8px 28px rgba(0,0,0,0.08);
    }
    .prod-card img {
      width: 100%; height: 100%; object-fit: cover; opacity: 0.9;
      transition: transform 1s ease;
    }
    .prod-card:hover img { transform: scale(1.1); }
    .prod-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to top,
        rgba(61,50,38,0.92) 0%,
        rgba(61,50,38,0.14) 50%, transparent 100%);
    }
    .prod-zoom {
      position: absolute; inset: 0;
      background: rgba(61,50,38,0.3); backdrop-filter: blur(2px);
      display: flex; align-items: center; justify-content: center;
      opacity: 0; transition: opacity 0.4s;
    }
    .prod-card:hover .prod-zoom { opacity: 1; }
    .zoom-icon {
      width: 48px; height: 48px; border-radius: 50%;
      background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.3);
      display: flex; align-items: center; justify-content: center;
    }
    .prod-info {
      position: absolute; bottom: 36px; left: 36px; right: 36px; color: white;
    }
    .prod-info .tag {
      display: block; font-size: 9px; font-weight: 900; letter-spacing: 0.3em;
      text-transform: uppercase; color: var(--terracotta); margin-bottom: 8px;
    }
    .prod-info h3 {
      font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 700;
      letter-spacing: -0.01em; margin: 0;
    }

    /* ========== GALERÍA ========== */
    #galeria { padding: 96px 0; background: white; }
    #gallery-grid {
      display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px;
    }
    @media (min-width: 1024px) { #gallery-grid { grid-template-columns: repeat(4, 1fr); gap: 24px; } }
    .gal-card {
      position: relative; aspect-ratio: 1; overflow: hidden;
      border-radius: 24px; cursor: pointer;
      background: rgba(61,50,38,0.1);
      box-shadow: 0 4px 16px rgba(0,0,0,0.07);
      transition: box-shadow 0.4s;
    }
    .gal-card:hover { box-shadow: 0 16px 40px rgba(0,0,0,0.15); }
    .gal-card img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s; }
    .gal-card:hover img { transform: scale(1.1); }
    .gal-overlay {
      position: absolute; inset: 0;
      background: rgba(61,50,38,0.44); backdrop-filter: blur(2px);
      display: flex; align-items: center; justify-content: center;
      opacity: 0; transition: opacity 0.4s;
    }
    .gal-card:hover .gal-overlay { opacity: 1; }
    .gal-overlay span {
      color: white; font-size: 10px; font-weight: 900;
      text-transform: uppercase; letter-spacing: 0.2em;
    }

    /* ========== CONTACTO ========== */
    #contacto { padding: 96px 0; background: var(--cream); }
    .contact-wrap {
      background: var(--chocolate); border-radius: 56px; overflow: hidden;
      display: flex; flex-direction: column;
      box-shadow: 0 24px 80px rgba(61,50,38,0.28);
    }
    @media (min-width: 1024px) { .contact-wrap { flex-direction: row; } }
    .c-info { padding: 60px 56px; color: white; }
    @media (min-width: 1024px) { .c-info { width: 40%; } }
    .c-form { background: white; padding: 60px 56px; }
    @media (min-width: 1024px) { .c-form { width: 60%; } }
    .c-info h2 {
      font-family: 'Playfair Display', serif; font-size: 26px; font-weight: 700;
      text-transform: uppercase; letter-spacing: -0.01em; line-height: 1.22; margin: 0 0 40px;
    }
    .c-row { display: flex; align-items: center; gap: 18px; margin-bottom: 24px; }
    .c-icon {
      width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0;
      background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12);
      display: flex; align-items: center; justify-content: center;
    }
    .c-label {
      display: block; font-size: 10px; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.2em;
      color: rgba(255,255,255,0.36); margin-bottom: 4px;
    }
    .c-value { font-size: 14px; font-weight: 500; }
    .social-row { display: flex; gap: 12px; margin-top: 40px; }
    .soc-btn {
      width: 40px; height: 40px; border-radius: 50%;
      background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12);
      display: flex; align-items: center; justify-content: center;
      color: white; text-decoration: none; transition: background 0.3s;
    }
    .soc-btn:hover { background: var(--terracotta); }
    .fgroup { margin-bottom: 28px; }
    .fgroup label {
      display: block; font-size: 9px; font-weight: 900;
      text-transform: uppercase; letter-spacing: 0.2em;
      color: rgba(61,50,38,0.38); margin-bottom: 8px; margin-left: 4px;
    }
    .fgroup input, .fgroup textarea {
      width: 100%; background: rgba(253,248,244,0.4);
      border: 1px solid rgba(61,50,38,0.08); border-radius: 16px;
      padding: 16px 22px; font-family: 'Inter', sans-serif;
      font-size: 14px; color: var(--chocolate); outline: none;
      transition: border-color 0.3s;
    }
    .fgroup input:focus, .fgroup textarea:focus { border-color: var(--terracotta); }
    .fgroup textarea { resize: none; }
    .btn-submit {
      width: 100%; padding: 20px; border: none; border-radius: 16px; cursor: pointer;
      background: var(--terracotta); color: white;
      font-family: 'Inter', sans-serif; font-size: 10px; font-weight: 900;
      text-transform: uppercase; letter-spacing: 0.2em;
      box-shadow: 0 8px 24px rgba(193,123,95,0.28); transition: background 0.3s, transform 0.2s;
    }
    .btn-submit:hover { background: var(--chocolate); }
    .btn-submit:active { transform: scale(0.98); }

    /* ========== FOOTER ========== */
    footer {
      background: var(--chocolate); padding: 80px 0;
      text-align: center; position: relative;
    }
    footer::before { content: ''; display: block; width: 100%; height: 1px; background: rgba(255,255,255,0.05); }
    .ft-logo { display: flex; flex-direction: column; align-items: center; margin-bottom: 36px; }
    .ft-nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 28px; margin-bottom: 28px; }
    .ft-nav a {
      font-size: 10px; font-weight: 900; letter-spacing: 0.2em; text-transform: uppercase;
      color: rgba(255,255,255,0.26); text-decoration: none; transition: color 0.3s;
    }
    .ft-nav a:hover { color: var(--terracotta); }
    .ft-sep { width: 48px; height: 1px; background: rgba(255,255,255,0.1); margin: 0 auto 22px; }
    .ft-copy { font-size: 10px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.48em; color: rgba(255,255,255,0.18); }

    /* ========== MODALS ========== */
    .modal-back {
      position: fixed; inset: 0; z-index: 200;
      background: rgba(61,50,38,0.9); backdrop-filter: blur(12px);
      display: none; align-items: center; justify-content: center; padding: 16px;
    }
    .modal-back.open { display: flex; }
    .modal-anim { animation: scaleIn 0.32s cubic-bezier(.22,.97,.59,1) both; }

    /* Product modal */
    #prod-modal-box {
      background: white; width: 100%; max-width: 1050px; max-height: 90vh;
      border-radius: 32px; overflow: hidden;
      display: flex; flex-direction: column;
      box-shadow: 0 40px 80px rgba(0,0,0,0.35);
    }
    @media (min-width: 768px) { #prod-modal-box { flex-direction: row; } }
    #modal-gal {
      padding: 24px; overflow-y: auto; background: rgba(253,248,244,0.6);
      scrollbar-width: none;
    }
    #modal-gal::-webkit-scrollbar { display: none; }
    @media (min-width: 768px) { #modal-gal { width: 60%; } }
    #modal-det {
      background: white; padding: 40px 48px;
      display: flex; flex-direction: column; justify-content: center;
    }
    @media (min-width: 768px) { #modal-det { width: 40%; } }

    /* Calc modal */
    #calc-box {
      background: white; width: 100%; max-width: 540px;
      border-radius: 22px; overflow: hidden;
      box-shadow: 0 40px 80px rgba(0,0,0,0.35);
    }
    .calc-head { background: var(--terracotta); padding: 22px 24px; color: white; display: flex; justify-content: space-between; align-items: flex-start; }
    .calc-body { padding: 22px 24px; display: flex; flex-direction: column; gap: 18px; }
    .calc-2col { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .c-label { display: block; font-size: 10px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.2em; color: rgba(61,50,38,0.52); margin-bottom: 7px; }
    .c-input {
      width: 100%; padding: 10px 14px; border-radius: 12px;
      border: 1px solid rgba(61,50,38,0.12); background: var(--cream);
      font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 700; color: var(--chocolate);
      outline: none; transition: border-color 0.3s;
    }
    .c-input:focus { border-color: var(--terracotta); }
    .toggle-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .tgl-btn {
      padding: 10px; border-radius: 12px; border: none; cursor: pointer;
      font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 900;
      text-transform: uppercase; letter-spacing: 0.1em;
      background: var(--cream); color: rgba(61,50,38,0.36); transition: all 0.28s;
    }
    .tgl-btn.on { background: var(--terracotta); color: white; box-shadow: 0 4px 14px rgba(193,123,95,0.3); }
    .calc-res { background: var(--chocolate); border-radius: 16px; padding: 18px 22px; color: white; }
    .calc-row { display: flex; justify-content: space-between; align-items: center; }
    .calc-rl { font-size: 10px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.2em; opacity: 0.52; }
    .calc-sep { height: 1px; background: rgba(255,255,255,0.1); margin: 10px 0; }
    .calc-av { font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 700; }
    .calc-pv { font-family: 'Playfair Display', serif; font-size: 26px; font-weight: 700; color: var(--terracotta); }
    .calc-note { font-size: 10px; text-align: center; color: rgba(255,255,255,0.42); margin-top: 10px; }
    .calc-btns { display: flex; gap: 10px; }
    .c-cancel {
      flex: 1; padding: 13px; border-radius: 12px; border: none; cursor: pointer;
      font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 900;
      text-transform: uppercase; letter-spacing: 0.1em;
      background: var(--cream); color: var(--chocolate);
    }
    .c-confirm {
      flex: 1; padding: 13px; border-radius: 12px; border: none; cursor: pointer;
      font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 900;
      text-transform: uppercase; letter-spacing: 0.1em;
      background: var(--terracotta); color: white;
      display: flex; align-items: center; justify-content: center; gap: 8px;
      box-shadow: 0 6px 20px rgba(193,123,95,0.28); transition: background 0.3s;
    }
    .c-confirm:hover { background: var(--chocolate); }
    .icon-x {
      background: none; border: none; cursor: pointer; padding: 4px;
      color: rgba(255,255,255,0.65); transition: color 0.3s;
    }
    .icon-x:hover { color: white; }
    .icon-x-dark {
      background: none; border: none; cursor: pointer; padding: 4px;
      color: rgba(61,50,38,0.22); transition: color 0.3s;
    }
    .icon-x-dark:hover { color: var(--chocolate); }

    /* ========== SCROLL REVEAL ========== */
    .reveal { opacity: 0; transform: translateY(26px); transition: opacity 0.7s ease, transform 0.7s ease; }
    .reveal.visible { opacity: 1; transform: none; }
    .reveal.d1 { transition-delay: 0.12s; }
    .reveal.d2 { transition-delay: 0.24s; }

    /* ========== KEYFRAMES ========== */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(28px); }
      to   { opacity: 1; transform: none; }
    }
    @keyframes scrollBounce {
      0%, 100% { transform: translateX(-50%) translateY(0); }
      50%       { transform: translateX(-50%) translateY(10px); }
    }
    @keyframes scaleIn {
      from { opacity: 0; transform: scale(0.93) translateY(14px); }
      to   { opacity: 1; transform: none; }
    }
  </style>
</head>
<body>

<!-- ============================================================
     NAVBAR
     ============================================================ -->
<nav id="navbar">
  <div class="nav-inner">

    <!-- Logo -->
    <a href="#inicio" id="logo-box">
      <svg width="48" height="27" viewBox="0 0 100 60" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin-bottom:5px">
        <path d="M10 40 L20 10 L80 10 L90 40 Z" fill="#1a1a1a"/>
        <path d="M25 10 L35 10 L40 40 L22 40 Z" fill="#dcc7aa"/>
        <path d="M45 10 L55 10 L60 40 L40 40 Z" fill="#dcc7aa"/>
        <path d="M65 10 L75 10 L78 40 L60 40 Z" fill="#dcc7aa"/>
        <circle cx="18" cy="40" r="8" fill="#1a1a1a"/>
        <circle cx="34" cy="40" r="8" fill="#1a1a1a"/>
        <circle cx="50" cy="40" r="8" fill="#1a1a1a"/>
        <circle cx="66" cy="40" r="8" fill="#1a1a1a"/>
        <circle cx="82" cy="40" r="8" fill="#1a1a1a"/>
        <circle cx="18" cy="40" r="5" fill="#dcc7aa"/>
        <circle cx="34" cy="40" r="5" fill="#dcc7aa"/>
        <circle cx="50" cy="40" r="5" fill="#dcc7aa"/>
        <circle cx="66" cy="40" r="5" fill="#dcc7aa"/>
        <circle cx="82" cy="40" r="5" fill="#dcc7aa"/>
      </svg>
      <span id="logo-name">BLOP</span>
      <span id="logo-tagline">Toldos y Cortinas</span>
    </a>

    <!-- Desktop links -->
    <div id="nav-links">
      <a href="#inicio"    class="nav-link">Inicio</a>
      <a href="#productos" class="nav-link">Productos</a>
      <a href="#servicios" class="nav-link">Servicios</a>
      <a href="#galeria"   class="nav-link">Galería</a>
      <a href="#contacto"  class="nav-link">Contacto</a>
    </div>

    <!-- Hamburger -->
    <button id="nav-hamburger" onclick="openMenu()">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
        <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </div>
</nav>

<!-- Mobile overlay -->
<div id="mobile-menu">
  <button id="mobile-close" onclick="closeMenu()">
    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
  <a href="#inicio"    onclick="closeMenu()" class="mobile-link">Inicio</a>
  <a href="#productos" onclick="closeMenu()" class="mobile-link">Productos</a>
  <a href="#servicios" onclick="closeMenu()" class="mobile-link">Servicios</a>
  <a href="#galeria"   onclick="closeMenu()" class="mobile-link">Galería</a>
  <a href="#contacto"  onclick="closeMenu()" class="mobile-link">Contacto</a>
  <a href="#contacto"  onclick="closeMenu()" class="mobile-cta">Cotización Gratis</a>
</div>

<!--============================================================
    HERO
    ============================================================ -->
<section id="inicio">
  <div id="hero">
    <div id="hero-bg">
      <img src="/public/images/dirty-old-wallpaper-textured-backdrop.jpg" alt="Terraza con toldo" />
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1>Elegancia<br><em>en cada</em><br>espacio</h1>
      <p>Toldos y cortinas diseñados para transformar tu entorno en una experiencia de confort absoluto.</p>
      <div class="hero-btns">
        <a href="#productos" class="btn-primary">Explorar Catálogo</a>
        <a href="#contacto"  class="btn-glass">Solicitar Cotización</a>
      </div>
    </div>
    <div class="scroll-hint">
      <div style="width:1px;height:60px;background:white;"></div>
      <span style="font-size:8px;font-weight:900;letter-spacing:0.4em;text-transform:uppercase;color:white;">Scroll</span>
    </div>
  </div>
</section>

<!-- ============================================================
     SERVICIOS
     ============================================================ -->
<section id="servicios">
  <div class="container">
    <div class="sec-header reveal">
      <div class="sec-label">
        <div class="sec-label-line"></div>
        <span>Excelencia Operativa</span>
        <div class="sec-label-line"></div>
      </div>
      <h2 class="sec-title">Nuestros Servicios</h2>
      <p class="sec-sub">Soluciones integrales de protección solar.</p>
      <div class="sec-divider">
        <div class="sd-line"></div><div class="sd-diamond"></div><div class="sd-line"></div>
      </div>
    </div>
    <div class="srv-grid">
      <div class="srv-card reveal">
        <div class="srv-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="none" viewBox="0 0 24 24" stroke="#c17b5f" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 9.75L12 3l9 6.75V21H15v-6H9v6H3V9.75z"/></svg>
        </div>
        <h3>Asesoría a Domicilio</h3>
        <p>Visitamos tu espacio para tomar medidas exactas y recomendarte la mejor opción.</p>
        <button class="calc-link" onclick="openCalc()">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="10" x2="16" y2="10"/><line x1="8" y1="14" x2="16" y2="14"/><line x1="8" y1="18" x2="12" y2="18"/></svg>
          Calcular Presupuesto
        </button>
      </div>
      <div class="srv-card reveal d1">
        <div class="srv-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="none" viewBox="0 0 24 24" stroke="#c17b5f" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/></svg>
        </div>
        <h3>Instalación Especializada</h3>
        <p>Contamos con técnicos certificados para asegurar un acabado impecable y seguro.</p>
      </div>
      <div class="srv-card reveal d2">
        <div class="srv-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="none" viewBox="0 0 24 24" stroke="#c17b5f" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h3>Mantenimiento</h3>
        <p>Servicio post-venta para limpieza técnica y ajuste de mecanismos.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================
     PRODUCTOS
     ============================================================ -->
<section id="productos">
  <div class="container">
    <div class="sec-header reveal">
      <div class="sec-label">
        <div class="sec-label-line"></div>
        <span>Diseño y Funcionalidad</span>
        <div class="sec-label-line"></div>
      </div>
      <h2 class="sec-title">Colección Exclusiva</h2>
      <p class="sec-sub">Una selección curada de sistemas de oscurecimiento y protección térmica para el hogar moderno.</p>
      <div class="sec-divider">
        <div class="sd-line"></div><div class="sd-diamond"></div><div class="sd-line"></div>
      </div>
    </div>
    <div class="filter-row">
      <button class="flt-btn active" data-f="Todos"    onclick="filterProds('Todos')">Todos</button>
      <button class="flt-btn"        data-f="Toldos"   onclick="filterProds('Toldos')">Toldos</button>
      <button class="flt-btn"        data-f="Cortinas" onclick="filterProds('Cortinas')">Cortinas</button>
    </div>
    <div id="products-grid"></div>
  </div>
</section>

<!-- Product modal -->
<div id="prod-modal" class="modal-back" onclick="closeProdModal()">
  <div id="prod-modal-box" class="modal-anim" onclick="event.stopPropagation()">
    <div id="modal-gal"></div>
    <div id="modal-det">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px;">
        <div>
          <span style="display:block;font-size:9px;font-weight:900;text-transform:uppercase;letter-spacing:0.4em;color:var(--terracotta);margin-bottom:8px;">Producto Premium</span>
          <h3 id="m-title" style="font-family:'Playfair Display',serif;font-size:24px;font-weight:700;color:var(--chocolate);text-transform:uppercase;letter-spacing:-0.01em;margin:0;line-height:1.1;"></h3>
        </div>
        <button onclick="closeProdModal()" class="icon-x-dark">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <p id="m-desc" style="font-size:14px;color:#64748b;font-weight:300;line-height:1.72;margin-bottom:32px;"></p>
      <div style="display:flex;flex-direction:column;gap:10px;">
        <button onclick="closeProdModal();document.getElementById('contacto').scrollIntoView({behavior:'smooth'})"
          style="width:100%;padding:16px;background:var(--chocolate);color:white;border:none;border-radius:14px;cursor:pointer;font-family:'Inter',sans-serif;font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:0.15em;display:flex;align-items:center;justify-content:center;gap:10px;transition:background 0.3s;"
          onmouseover="this.style.background='var(--terracotta)'" onmouseout="this.style.background='var(--chocolate)'">
          Solicitar Cotización
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </button>
        <button id="m-calc-btn" onclick="closeProdModal();openCalc()"
          style="display:none;width:100%;padding:16px;background:var(--cream);color:var(--chocolate);border:1px solid rgba(61,50,38,0.07);border-radius:14px;cursor:pointer;font-family:'Inter',sans-serif;font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:0.15em;align-items:center;justify-content:center;gap:10px;">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="#c17b5f" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="10" x2="16" y2="10"/><line x1="8" y1="14" x2="16" y2="14"/><line x1="8" y1="18" x2="12" y2="18"/></svg>
          Abrir Calculadora
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ============================================================
     GALERÍA
     ============================================================ -->
<section id="galeria">
  <div class="container">
    <div class="sec-header reveal">
      <div class="sec-label">
        <div class="sec-label-line"></div>
        <span>Nuestro Portafolio</span>
        <div class="sec-label-line"></div>
      </div>
      <h2 class="sec-title">Casas con Estilo BLOP</h2>
      <p class="sec-sub">Testimonios visuales de cómo transformamos la luz en confort en las residencias más exclusivas.</p>
    </div>
    <div id="gallery-grid"></div>
  </div>
</section>

<!-- Gallery lightbox -->
<div id="gal-modal" class="modal-back" onclick="closeGalModal()">
  <button onclick="closeGalModal()" style="position:absolute;top:28px;right:28px;width:48px;height:48px;background:white;border:none;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 4px 16px rgba(0,0,0,0.3);z-index:10;">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
  <img id="gal-img" src="" onclick="event.stopPropagation()" style="max-width:100%;max-height:80vh;border-radius:16px;border:1px solid rgba(255,255,255,0.1);box-shadow:0 24px 60px rgba(0,0,0,0.4);animation:scaleIn 0.3s ease both;" />
  <div style="position:absolute;bottom:36px;text-align:center;pointer-events:none;">
    <p id="gal-cat"   style="font-size:10px;text-transform:uppercase;letter-spacing:0.2em;color:rgba(255,255,255,0.5);margin:0 0 4px;"></p>
    <h3 id="gal-title" style="font-family:'Playfair Display',serif;font-size:20px;color:white;margin:0;font-weight:700;"></h3>
  </div>
</div>

<!-- ============================================================
     CONTACTO
     ============================================================ -->
<section id="contacto">
  <div class="container">
    <div class="sec-header reveal">
      <div class="sec-label">
        <div class="sec-label-line"></div>
        <span>Hablemos hoy</span>
        <div class="sec-label-line"></div>
      </div>
      <h2 class="sec-title">Dale Vida a tus Espacios</h2>
      <p class="sec-sub">Agenda una consultoría técnica sin costo para tu próximo proyecto de remodelación.</p>
    </div>
    <div class="contact-wrap">
      <div class="c-info">
        <span style="display:block;font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:0.4em;color:var(--terracotta);margin-bottom:20px;">Ubicación y Contacto</span>
        <h2>Estamos listos para escucharte</h2>
        <div class="c-row">
          <div class="c-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="#c17b5f" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          </div>
          <div>
            <span class="c-label">Teléfono</span>
            <span class="c-value">+54 2612776559</span>
          </div>
        </div>
        <div class="c-row">
          <div class="c-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="#c17b5f" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <div>
            <span class="c-label">Email</span>
            <span class="c-value">elias.perezz998@gmail.com</span>
          </div>
        </div>
        <div class="social-row">
          <a href="#" class="soc-btn"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg></a>
          <a href="#" class="soc-btn"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg></a>
        </div>
      </div>
      <div class="c-form">
        <div id="form-ok" style="display:none;text-align:center;padding:40px 0;">
          <div style="width:80px;height:80px;border-radius:50%;background:#f0fdf4;display:flex;align-items:center;justify-content:center;margin:0 auto 22px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="none" viewBox="0 0 24 24" stroke="#22c55e" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <h3 style="font-family:'Playfair Display',serif;font-size:24px;color:var(--chocolate);margin:0 0 10px;">¡Solicitud Enviada!</h3>
          <p style="font-size:14px;color:#64748b;">Nuestro equipo te contactará en las próximas 24 horas.</p>
          <button onclick="resetForm()" style="margin-top:22px;background:none;border:none;cursor:pointer;color:var(--terracotta);font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:0.2em;font-family:'Inter',sans-serif;">Enviar otro mensaje</button>
        </div>
        <form id="contact-form" onsubmit="sendForm(event)" style="max-width:500px;">
          <div class="fgroup">
            <label>Nombre Completo</label>
            <input required type="text" placeholder="Ej. Juan Pérez" />
          </div>
          <div class="fgroup">
            <label>Correo Electrónico</label>
            <input required type="email" placeholder="juan@ejemplo.com" />
          </div>
          <div class="fgroup">
            <label>Mensaje o Detalles</label>
            <textarea id="msg" required rows="4" placeholder="Cuéntanos sobre tu terraza o ventanas..."></textarea>
          </div>
          <button type="submit" id="sub-btn" class="btn-submit">Solicitar Presupuesto</button>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================
     FOOTER
     ============================================================ -->
<footer>
  <div class="ft-logo">
    <svg width="48" height="27" viewBox="0 0 100 60" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin-bottom:6px">
      <path d="M10 40 L20 10 L80 10 L90 40 Z" fill="#fdf8f4"/>
      <path d="M25 10 L35 10 L40 40 L22 40 Z" fill="#dcc7aa"/>
      <path d="M45 10 L55 10 L60 40 L40 40 Z" fill="#dcc7aa"/>
      <path d="M65 10 L75 10 L78 40 L60 40 Z" fill="#dcc7aa"/>
      <circle cx="18" cy="40" r="8" fill="#fdf8f4"/><circle cx="34" cy="40" r="8" fill="#fdf8f4"/>
      <circle cx="50" cy="40" r="8" fill="#fdf8f4"/><circle cx="66" cy="40" r="8" fill="#fdf8f4"/>
      <circle cx="82" cy="40" r="8" fill="#fdf8f4"/>
      <circle cx="18" cy="40" r="5" fill="#dcc7aa"/><circle cx="34" cy="40" r="5" fill="#dcc7aa"/>
      <circle cx="50" cy="40" r="5" fill="#dcc7aa"/><circle cx="66" cy="40" r="5" fill="#dcc7aa"/>
      <circle cx="82" cy="40" r="5" fill="#dcc7aa"/>
    </svg>
    <span style="font-weight:900;font-size:22px;letter-spacing:-0.02em;color:white;">BLOP</span>
    <span style="font-size:10px;font-weight:700;letter-spacing:0.26em;text-transform:uppercase;margin-top:4px;color:rgba(255,255,255,0.84);">Toldos y Cortinas</span>
  </div>
  <nav class="ft-nav">
    <a href="#inicio">Inicio</a>
    <a href="#productos">Productos</a>
    <a href="#servicios">Servicios</a>
    <a href="#galeria">Galería</a>
    <a href="#contacto">Contacto</a>
  </nav>
  <div class="ft-sep"></div>
  <p class="ft-copy">© 2025 BLOP STUDIO — ARTISANS OF SHADE</p>
</footer>

<!-- ============================================================
     CALCULATOR MODAL
     ============================================================ -->
<div id="calc-modal" class="modal-back" onclick="closeCalc()">
  <div id="calc-box" class="modal-anim" onclick="event.stopPropagation()">
    <div class="calc-head">
      <div>
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:4px;">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="10" x2="16" y2="10"/><line x1="8" y1="14" x2="16" y2="14"/><line x1="8" y1="18" x2="12" y2="18"/></svg>
          <h2 style="font-family:'Playfair Display',serif;font-size:20px;font-weight:700;margin:0;">Calculadora de Toldo</h2>
        </div>
        <p style="font-size:12px;color:rgba(255,255,255,0.76);margin:0;">Obtén un presupuesto estimado al instante</p>
      </div>
      <button onclick="closeCalc()" class="icon-x">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="calc-body">
      <div class="calc-2col">
        <div><label class="c-label">Ancho (metros)</label><input id="cw" class="c-input" type="number" min="1" max="10" step="0.5" value="3" oninput="updCalc()" /></div>
        <div><label class="c-label">Largo (metros)</label><input id="cl" class="c-input" type="number" min="1" max="10" step="0.5" value="2" oninput="updCalc()" /></div>
      </div>
      <div>
        <label class="c-label">Tipo de Accionamiento</label>
        <div class="toggle-row">
          <button class="tgl-btn on" data-tp="manual"     onclick="setTp('manual')">Manual</button>
          <button class="tgl-btn"    data-tp="motorizado" onclick="setTp('motorizado')">Motorizado</button>
        </div>
      </div>
      <div>
        <label class="c-label">Tipo de Tela</label>
        <div class="toggle-row">
          <button class="tgl-btn on" data-fb="acrilico"  onclick="setFb('acrilico')">Acrílico Premium</button>
          <button class="tgl-btn"    data-fb="poliester" onclick="setFb('poliester')">Poliéster Standard</button>
        </div>
      </div>
      <div class="calc-res">
        <div class="calc-row"><span class="calc-rl">Área Total</span><span id="r-area" class="calc-av">6.0 m²</span></div>
        <div class="calc-sep"></div>
        <div class="calc-row"><span class="calc-rl">Presupuesto Estimado</span><span id="r-price" class="calc-pv">$108.000</span></div>
        <p class="calc-note">*Precio orientativo. Consulta por precio final con instalación.</p>
      </div>
      <div class="calc-btns">
        <button class="c-cancel" onclick="closeCalc()">Cancelar</button>
        <button class="c-confirm" onclick="confirmCalc()">
          Solicitar Cotización
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </button>
      </div>
    </div>
  </div>
</div>


<!-- ============================================================
     JAVASCRIPT
     ============================================================ -->
<script>
/* ---------- DATA ---------- */
const PRODUCTS = [
  { id:'p1', cat:'Toldos', title:'TOLDOS EXTERIORES', desc:'Resistencia UV y Estilo',
    long:'Nuestros toldos exteriores combinan tejidos acrílicos de alta gama con herrajes de aluminio lacado. Ideales para terrazas y balcones, ofrecen hasta un 95% de protección contra rayos UV.',
    img:'/images/IMG_20260110_180223.jpg',
    gal:['/toldos exteriores/images/541519615_17846468445559621_4424188347483988336_n.webp','toldos exteriores/images/560039397_17851134444559621_3291951586725967056_n.webp','toldos exteriores/images/573133510_17854492977559621_8213393413093721684_n.webp','toldos exteriores/images/exterior-de-alta-calidad-con-dosel-deslizante.webp']
  },
  { id:'p2', cat:'Cortinas', title:'CORTINAS ROLLER', desc:'Privacidad y Control Lumínico',
    long:'Sistemas Roller Blackout, Sunscreen y Zebra. Telas técnicas que permiten el control térmico y visual absoluto en interiores modernos y oficinas.',
    img:'cortinas roller/images/544040417_17845949157559621_2438940972704635050_n.webp',
    gal:['cortinas roller/images/541573061_17846155686559621_6159944503335270829_n.webp','cortinas roller/images/541529962_17845949724559621_8088245377484870718_n.webp','cortinas roller/images/004-Screen-Gris-color.webp','cortinas roller/images/products-2421.webp']
  },
  { id:'p3', cat:'Toldos', title:'PÉRGOLAS BIOCLIMÁTICAS', desc:'Confort Térmico Todo el Año',
    long:'Estructuras bioclimáticas de lamas orientables. Crea un microclima en tu jardín controlando la entrada de sol y ventilación de forma automática.',
    img:'https://images.unsplash.com/photo-1513519245088-0e12902e35ca?auto=format&fit=crop&q=80&w=1200',
    gal:['https://images.unsplash.com/photo-1600585154526-990dcea4db0d?auto=format&fit=crop&q=80&w=800','https://images.unsplash.com/photo-1613977257363-707ba9348227?auto=format&fit=crop&q=80&w=800','https://images.unsplash.com/photo-1512918766775-d22223a4115b?auto=format&fit=crop&q=80&w=800']
  }
];
const GALLERY = [
  { id:'g1', url:'fotos de la galeria/images/556778647_17850647805559621_1622085003609558392_n.webp', title:'Terraza Moderna', cat:'Toldos' },
  { id:'g2', url:'fotos de la galeria/images/569273167_17854370937559621_2187570846176103218_n.webp', title:'Salón Minimalista', cat:'Cortinas' }
];

/* ---------- NAVBAR ---------- */
window.addEventListener('scroll', () => {
  document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 20);
});

/* ---------- MOBILE MENU ---------- */
function openMenu()  { document.getElementById('mobile-menu').classList.add('open'); document.body.style.overflow='hidden'; }
function closeMenu() { document.getElementById('mobile-menu').classList.remove('open'); document.body.style.overflow=''; }

/* ---------- SCROLL REVEAL ---------- */
const ro = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }), { threshold:0.1, rootMargin:'-30px' });
document.querySelectorAll('.reveal').forEach(el => ro.observe(el));

/* ---------- PRODUCTS ---------- */
let activeF = 'Todos';
function renderProds() {
  const list = activeF === 'Todos' ? PRODUCTS : PRODUCTS.filter(p => p.cat === activeF);
  document.getElementById('products-grid').innerHTML = list.map(p => `
    <div class="prod-card" onclick="openProdModal('${p.id}')">
      <img src="${p.img}" alt="${p.title}" loading="lazy" />
      <div class="prod-overlay"></div>
      <div class="prod-zoom"><div class="zoom-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="white" stroke-width="2"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg></div></div>
      <div class="prod-info"><span class="tag">${p.desc}</span><h3>${p.title}</h3></div>
    </div>`).join('');
}
function filterProds(f) {
  activeF = f;
  document.querySelectorAll('.flt-btn').forEach(b => b.classList.toggle('active', b.dataset.f === f));
  renderProds();
}
function openProdModal(id) {
  const p = PRODUCTS.find(x => x.id === id);
  document.getElementById('m-title').textContent = p.title;
  document.getElementById('m-desc').textContent  = p.long;
  document.getElementById('modal-gal').innerHTML =
    `<img src="${p.img}" style="width:100%;border-radius:20px;aspect-ratio:16/9;object-fit:cover;display:block;" loading="lazy" />
     <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px;">
       ${p.gal.map(i=>`<img src="${i}" style="width:100%;border-radius:18px;aspect-ratio:1;object-fit:cover;" loading="lazy" />`).join('')}
     </div>`;
  const cb = document.getElementById('m-calc-btn');
  cb.style.display = p.cat === 'Toldos' ? 'flex' : 'none';
  document.getElementById('prod-modal').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeProdModal() { document.getElementById('prod-modal').classList.remove('open'); document.body.style.overflow=''; }

/* ---------- GALLERY ---------- */
function renderGal() {
  document.getElementById('gallery-grid').innerHTML = GALLERY.map(g =>
    `<div class="gal-card" onclick="openGalModal('${g.id}')">
       <img src="${g.url}" alt="${g.title}" loading="lazy" />
       <div class="gal-overlay"><span>${g.title}</span></div>
     </div>`).join('');
}
function openGalModal(id) {
  const g = GALLERY.find(x => x.id === id);
  document.getElementById('gal-img').src = g.url;
  document.getElementById('gal-cat').textContent   = g.cat;
  document.getElementById('gal-title').textContent = g.title;
  document.getElementById('gal-modal').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeGalModal() { document.getElementById('gal-modal').classList.remove('open'); document.body.style.overflow=''; }

/* ---------- FORM ---------- */
function sendForm(e) {
  e.preventDefault();
  const btn = document.getElementById('sub-btn');
  btn.textContent = 'Enviando...'; btn.style.opacity = '0.75';
  setTimeout(() => {
    document.getElementById('contact-form').style.display = 'none';
    document.getElementById('form-ok').style.display = 'block';
  }, 1800);
}
function resetForm() {
  document.getElementById('form-ok').style.display = 'none';
  document.getElementById('contact-form').style.display = '';
  document.getElementById('contact-form').reset();
  document.getElementById('sub-btn').textContent = 'Solicitar Presupuesto';
  document.getElementById('sub-btn').style.opacity = '';
}

/* ---------- CALCULATOR ---------- */
let cType = 'manual', cFab = 'acrilico';
function openCalc()  { document.getElementById('calc-modal').classList.add('open'); document.body.style.overflow='hidden'; updCalc(); }
function closeCalc() { document.getElementById('calc-modal').classList.remove('open'); document.body.style.overflow=''; }
function setTp(t) { cType=t; document.querySelectorAll('[data-tp]').forEach(b => b.classList.toggle('on', b.dataset.tp===t)); updCalc(); }
function setFb(f) { cFab=f;  document.querySelectorAll('[data-fb]').forEach(b => b.classList.toggle('on', b.dataset.fb===f)); updCalc(); }
function updCalc() {
  const w = parseFloat(document.getElementById('cw').value)||0;
  const l = parseFloat(document.getElementById('cl').value)||0;
  const area  = w*l;
  const price = Math.round(area*15000*(cFab==='acrilico'?1.2:1)+(cType==='motorizado'?8000:0));
  document.getElementById('r-area').textContent  = area.toFixed(1)+' m²';
  document.getElementById('r-price').textContent = '$'+price.toLocaleString('es-AR');
}
function confirmCalc() {
  const w=document.getElementById('cw').value, l=document.getElementById('cl').value;
  const msg=`Calculadora de Toldo:\n- Ancho: ${w}m | Largo: ${l}m | Área: ${(w*l).toFixed(1)}m²\n- Tipo: ${cType} | Tela: ${cFab}\n- Presupuesto: ${document.getElementById('r-price').textContent}`;
  closeCalc();
  const ta=document.getElementById('msg'); if(ta) ta.value=msg;
  document.getElementById('contacto').scrollIntoView({behavior:'smooth'});
}

/* ---------- ESC ---------- */
document.addEventListener('keydown', e => { if(e.key==='Escape'){closeProdModal();closeGalModal();closeCalc();closeMenu();} });

/* ---------- INIT ---------- */
renderProds();
renderGal();
</script>
</body>
</html>
